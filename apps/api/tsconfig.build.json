{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    // `nest build` deletes dist/ first; an incremental .tsbuildinfo left
    // outside it makes tsc skip unchanged files and emit a partial build.
    "incremental": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}

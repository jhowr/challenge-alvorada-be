{
  "compilerOptions": {
    // Imports are written without extensions; `nest build` (SWC) adds them
    // to the emitted ES modules, and tsx/Vitest resolve them in development.
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "isolatedModules": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2024",
    "sourceMap": true,
    // tsc only type-checks; `nest build` (SWC) writes to outDir.
    "outDir": "./dist",
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"]
  }
}
